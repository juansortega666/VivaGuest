# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example es el contrato de variables de entorno y SI se versiona: no lleva
# ningun valor real. La excepcion va despues del patron o `.env*` la vuelve a tragar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
# e2e/.auth/ guarda storageState con cookies de sesion y las contrasenas generadas
# por corrida. Son usuarios de prueba contra la base local, pero no tienen por que
# viajar en el historial.
/e2e/.auth/
/playwright-report/
/test-results/

# service worker generado por Serwist
# `public/sw.js` y sus chunks los EMITE `next build` desde `app/sw.ts`. Son
# artefactos de build, no assets: versionarlos garantiza un conflicto en cada
# merge y, peor, un service worker obsoleto desplegado sobre el que nadie
# reparo. La fuente versionada es `app/sw.ts` y solo esa.
# Los cinco PNG de `public/` SI se versionan: esos son assets de marca.
public/sw*
public/swe-worker*

# Cache de las herramientas de investigacion. Es transitorio y por maquina.
.planning/research/.cache/
.planning/state.json

# Lock de sesion de GSD: efimero, por sesion y por PID.
.planning/milestone.lock
