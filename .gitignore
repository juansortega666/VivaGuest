# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example es el contrato de variables de entorno y SI se versiona: no lleva
# ningun valor real. La excepcion va despues del patron o `.env*` la vuelve a tragar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
