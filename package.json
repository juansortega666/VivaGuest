{
  "name": "vivaguest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local",
    "db:advisors": "supabase db advisors --local --type security --fail-on error",
    "db:types": "supabase gen types typescript --local --schema public > lib/database.types.ts",
    "db:types:check": "supabase gen types typescript --local --schema public > /tmp/vg.types.gen.ts && diff -u lib/database.types.ts /tmp/vg.types.gen.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "ci:arch": "bash scripts/ci/check-service-role.sh && bash scripts/ci/check-max-w-tallas.sh && bash scripts/ci/check-escala-movil.sh",
    "setup:worktree": "bash scripts/dev/setup-worktree.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hookform/resolvers": "5.9.1",
    "@serwist/next": "9.5.12",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.39.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "server-only": "^0.0.1",
    "shadcn": "4.19.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "web-push": "3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "serwist": "9.5.12",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
